msgstr "Quick keyboard shortcuts"

msgid "help.shortcuts_subtitle"
msgstr "Operate the entire protection and navigation workflow without taking your hands off the keyboard."

msgid "help.studio_audit_desc"
msgstr "When dragging or scanning files and folders, the pre-inspection screen opens automatically. LexiShield classifies tokens by Network, Identity, Systems, or Keys, letting you omit false positives before saving them to your vault."

msgid "help.studio_audit_title"
